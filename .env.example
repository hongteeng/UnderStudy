# Required by every OpenAI-powered command in this project.
OPENAI_API_KEY=replace_with_your_api_key

# Answer generation and transcript-to-rules extraction.
OPENAI_MODEL=gpt-5.6-sol

# Lesson transcription.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Optional: leave blank to let the model detect the language.
TRANSCRIPTION_LANGUAGE=

# Speaker reference clips are teacher-specific. Pass --teacher-name and
# --teacher-reference to transcribe_recordings.py instead of storing them here.

# Optional default used by individual commands when only one teacher is not
# enough to select a workspace.
# UNDERSTUDY_TEACHER=hong-ting

# Worker settings.
UNDERSTUDY_SETTLE_SECONDS=20
UNDERSTUDY_POLL_SECONDS=30
TRANSCRIPTION_MAX_UPLOAD_MB=24
TRANSCRIPTION_API_RETRIES=3
