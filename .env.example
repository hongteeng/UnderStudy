# Required by every OpenAI-powered command in this project.
OPENAI_API_KEY=replace_with_your_api_key

# Answer generation and transcript-to-rules extraction.
OPENAI_MODEL=gpt-5.6-sol

# Lesson transcription.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Optional: leave blank to let the model detect the language.
TRANSCRIPTION_LANGUAGE=

# Optional but recommended for reliable teacher/student speaker labels.
# Set both values or leave both blank.
# TEACHER_SPEAKER_NAME=Hong Ting
# TEACHER_REFERENCE_AUDIO=/absolute/path/to/hong_ting_reference.m4a

# Folder and worker settings. The incoming folder may point to a synced
# Dropbox, Google Drive, or iCloud folder instead of the project default.
# UNDERSTUDY_INCOMING_DIR=/absolute/path/to/synced/lesson-recordings
UNDERSTUDY_SETTLE_SECONDS=20
UNDERSTUDY_POLL_SECONDS=30
TRANSCRIPTION_MAX_UPLOAD_MB=24
TRANSCRIPTION_API_RETRIES=3
